{
  "name": "masum-galaxy-cp-arena",
  "displayName": "Masum Galaxy // CP Arena",
  "description": "A competitive programming cockpit for VS Code with local judging, verdict diffs, benchmarks, stress testing, contest tools, snippets, and AI coaching.",
  "version": "1.0.0",
  "publisher": "gitwithmasum",
  "author": {
    "name": "Masum Billah",
    "url": "https://github.com/gitwithmasum"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Testing",
    "Education"
  ],
  "keywords": [
    "competitive programming",
    "cp arena",
    "competitive coding",
    "cp toolkit",
    "codeforces",
    "atcoder",
    "leetcode",
    "codechef",
    "local judge",
    "online judge",
    "stress testing",
    "stress tester",
    "test cases",
    "verdict diff",
    "wrong answer",
    "runtime benchmark",
    "memory benchmark",
    "contest timer",
    "problem tracker",
    "c++",
    "python",
    "javascript",
    "snippets",
    "templates",
    "ai coach",
    "complexity analysis",
    "edge cases",
    "problem solving",
    "coding contest",
    "developer tools"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:masumGalaxyCpArena.sidebar",
    "onCommand:masumGalaxyCpArena.open",
    "onCommand:masumGalaxyCpArena.newContest",
    "onCommand:masumGalaxyCpArena.newProblem",
    "onCommand:masumGalaxyCpArena.stressTest",
    "onCommand:masumGalaxyCpArena.snippets",
    "onCommand:masumGalaxyCpArena.focusMode",
    "onCommand:masumGalaxyCpArena.runLastSample",
    "onCommand:masumGalaxyCpArena.runLastMulti",
    "onCommand:masumGalaxyCpArena.markAccepted",
    "onCommand:masumGalaxyCpArena.nextProblem",
    "onCommand:masumGalaxyCpArena.rerunStressFailure"
  ],
  "contributes": {
    "commands": [
      {
        "command": "masumGalaxyCpArena.open",
        "title": "Masum Galaxy CP Arena: Open Arena"
      },
      {
        "command": "masumGalaxyCpArena.newContest",
        "title": "Masum Galaxy CP Arena: Start New Contest"
      },
      {
        "command": "masumGalaxyCpArena.newProblem",
        "title": "Masum Galaxy CP Arena: New Problem File"
      },
      {
        "command": "masumGalaxyCpArena.stressTest",
        "title": "Masum Galaxy CP Arena: Run Stress Test"
      },
      {
        "command": "masumGalaxyCpArena.snippets",
        "title": "Masum Galaxy CP Arena: Open Snippet Vault"
      },
      {
        "command": "masumGalaxyCpArena.focusMode",
        "title": "Masum Galaxy CP Arena: Toggle CP Focus Mode"
      },
      {
        "command": "masumGalaxyCpArena.runLastSample",
        "title": "Masum Galaxy CP Arena: Run Last Sample"
      },
      {
        "command": "masumGalaxyCpArena.runLastMulti",
        "title": "Masum Galaxy CP Arena: Run Last Multi Cases"
      },
      {
        "command": "masumGalaxyCpArena.markAccepted",
        "title": "Masum Galaxy CP Arena: Mark Current Problem AC"
      },
      {
        "command": "masumGalaxyCpArena.nextProblem",
        "title": "Masum Galaxy CP Arena: Switch to Next Problem"
      },
      {
        "command": "masumGalaxyCpArena.rerunStressFailure",
        "title": "Masum Galaxy CP Arena: Re-run Last Stress Failure"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "masumGalaxyCpArena",
          "title": "Galaxy CP Arena",
          "icon": "media/cp-arena.svg"
        }
      ]
    },
    "views": {
      "masumGalaxyCpArena": [
        {
          "type": "webview",
          "id": "masumGalaxyCpArena.sidebar",
          "name": "CP Arena"
        }
      ]
    },
    "keybindings": [
      {
        "command": "masumGalaxyCpArena.runLastSample",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c || editorLangId == python || editorLangId == javascript)"
      },
      {
        "command": "masumGalaxyCpArena.runLastMulti",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c || editorLangId == python || editorLangId == javascript)"
      },
      {
        "command": "masumGalaxyCpArena.stressTest",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && (editorLangId == cpp || editorLangId == c || editorLangId == python || editorLangId == javascript)"
      },
      {
        "command": "masumGalaxyCpArena.markAccepted",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "masumGalaxyCpArena.nextProblem",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CP Arena compiles and runs source files from the current workspace."
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/arena.js && node --check src/core/workspace.js && node --check src/features/cp-core.js && node --check src/features/cp.js && node --check test/cp-core.test.js && node --check test/marketplace.test.js",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run check && npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwithmasum/MG-VS-Code-CP-Arena.git"
  },
  "homepage": "https://github.com/gitwithmasum/MG-VS-Code-CP-Arena#readme",
  "bugs": {
    "url": "https://github.com/gitwithmasum/MG-VS-Code-CP-Arena/issues"
  },
  "galleryBanner": {
    "color": "#050817",
    "theme": "dark"
  },
  "pricing": "Free",
  "icon": "media/cp-arena-icon.png"
}
